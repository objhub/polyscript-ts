@param 1..7 label:"Column" desc:"Keyboard column"
col = 3
@param 1..5 label:"Row" desc:"Keyboard row"
row = 2

case_w = 19 * col + 10
case_d = 19 * row + 10
case_h = 20
box case_w case_d case_h at: 0 0 10
 | faces <Z | shell 2
 | edges [>Z, =Z] | fillet 3
 | faces >Z | rect 14 14 | grid col row 19 | cut # sw hole
 | faces >Y | circle 2 | cut 3                   # cable hole

rect (case_w - 4.5) (case_d - 4.5)
 | verts | cone 2 0 5 center:true true false
