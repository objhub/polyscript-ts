# Hex bolt with an ISO metric thread (M16 x P2)
#
# Head at the bottom (prints flat, no supports), the thread cut straight into
# the shank. M16 coarse (JIS B 0205 / ISO 261: d16 x P2) with the head from
# JIS B 1180 (across flats s = 24, height k = 10). The coarse 2 mm pitch is
# what makes the thread printable: a 1.5 mm deep groove with a 0.25 mm flat on
# the crest clears a 0.4 mm nozzle, where M8's P1.25 does not.
#
# Two OCCT lessons are baked into the groove profile:
# - The profile overhangs the shank surface (lead) instead of exactly touching
#   it. A tool tangent to the surface leaves micron-thin sliver solids in the
#   grooves; overhanging the same flank lines cuts the identical groove with
#   zero debris.
# - Adjacent turns of the tool must not touch each other. The crest is the
#   land left between neighbouring grooves; with land = 0 the swept tool is
#   tangent to itself turn-to-turn and a later boolean silently returns
#   nothing. ISO truncates the crest to pitch/8 for good reason. The guard is
#   hw * (lead + gd) / gd < pitch / 2, which is why `lead` shrinks with `land`.
#

pitch = 2
r = 8          # shank radius: d16 / 2
shank = 30     # shank length

# Threaded length, measured from the tip, as JIS B 1180 / ISO 4014 measure `b`.
# A partly threaded hex bolt has b = 2d + 6 for lengths up to 125 mm, so an
# M16 would be b = 38 -- longer than this shank, which is why a bolt this short
# is fully threaded (JIS B 1180 全ねじ / ISO 4017). A smaller value leaves a
# plain shank under the head.
thread_len = shank - 2

head_h = 10
hr = 13.856    # hex head circumradius: across flats 24 / sqrt(3)

land = pitch / 8       # crest flat left between grooves (ISO metric truncation)
hw = (pitch - land) / 2   # groove half-width at the shank surface
gd = hw * 1.7320508    # groove depth for 60-degree flanks: half-width / tan(30)
lead = gd / 8          # tool overhang past the shank surface (see the guard above)
groove = polyline [(lead, -(hw * (1 + lead / gd))),
                   (-gd, 0),
                   (lead, hw * (1 + lead / gd))]

# Where the thread starts, in shank coordinates (0 = seat, `shank` = tip).
# `runout` is the 不完全ねじ部: the groove begins that much below the nominal
# thread length, as a rolled thread runs out into the plain shank. With a full
# thread it takes the groove 1 mm past the seat, so it does not end on the
# head's face.
runout = 1
thread_z0 = shank - thread_len - runout

# The tip is chamfered at 45 degrees down to the thread root (ISO 4753 type
# CH), which is what lets a nut start. Chamfer the plain cylinder first: after
# the thread is cut, the tip's rim is broken by the groove and `chamfer` only
# gets part of it.
tip = gd + lead

# The tool is swept 2 mm too long at the start and cut back to a plane at
# thread_z0, so the thread begins on a flat circle all the way round instead
# of on the sweep's own slanted cap.
shaft = cylinder r shank | floor
 | faces ">Z" | chamfer tip
 | diff (helix pitch (shank + 4 - thread_z0) r
         | sweep groove
         | translate 0 0 (thread_z0 - 2)
         | inter (cylinder (r + 1) (shank + 8) | floor | translate 0 0 thread_z0))
 | translate 0 0 head_h

head = polygon 6 hr
 | extrude head_h
 | faces "<Z" | chamfer 1

union [head, shaft]
