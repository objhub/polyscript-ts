{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // This package ships .ts and .svelte sources and is consumed through a
    // bundler (`live` and `objhub/www` link it directly), so it needs bundler
    // resolution rather than the repo default of Node16.
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["svelte"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte"]
}
