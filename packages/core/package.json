{
  "name": "@polyscript/core",
  "version": "0.1.0",
  "description": "PolyScript core — parser, AST, validation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ocp-kernel": {
      "types": "./dist/ocp-kernel.d.ts",
      "import": "./dist/ocp-kernel.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "tsc --noEmit && biome lint src/ test/"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/opentype.js": "^1.3.9",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "~5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "occt-wasm": "https://github.com/polygoro/occt-wasm/releases/download/v4.3.2-ps1/occt-wasm-4.3.2-ps1.tgz",
    "opentype.js": "^1.3.4"
  }
}
